# Configure these in Railway > Service > Variables. Do not commit real values.
BOT_TOKEN=123456:YOUR_TELEGRAM_BOT_TOKEN
SUPPORT_GROUP_ID=-1001234567890
DATABASE_URL=postgresql://username:password@db-host:5432/dbname
# RECOMMENDED: only these numeric Telegram IDs manage staff and broadcasts.
# When unset, existing AUTHORIZED_STAFF_IDS temporarily retain legacy owner rights.
OWNER_IDS=123456789
# Initial staff IDs. Removing with /removestaff remains effective across restarts.
AUTHORIZED_STAFF_IDS=123456789,234567890
PRIVACY_POLICY_URL=https://your-site.example/privacy
# Set to 0 to disable automatic retention cleanup until policy is finalized.
RETENTION_DAYS=0
MAX_DELIVERY_ATTEMPTS=8
BROADCAST_GAP_SECONDS=0.15
